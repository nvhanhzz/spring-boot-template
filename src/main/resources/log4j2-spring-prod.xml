<?xml version="1.0" encoding="UTF-8"?>
<Configuration status="WARN" monitorInterval="60">

    <Properties>
        <Property name="LOG_PATTERN">%d{yyyy-MM-dd HH:mm:ss.SSS} [%t] %-5level %logger{36} - %msg%n</Property>
        <Property name="LOG_PATH">${sys:LOG_DIR:-/var/log/scada}</Property>
        <Property name="APP_NAME">scada</Property>
    </Properties>

    <Appenders>
        <Console name="Console" target="SYSTEM_OUT">
            <PatternLayout pattern="${LOG_PATTERN}" />
            <ThresholdFilter level="INFO" onMatch="ACCEPT" onMismatch="DENY"/>
        </Console>

        <RollingFile name="AppFile"
                     fileName="${LOG_PATH}/app/${APP_NAME}.log"
                     filePattern="${LOG_PATH}/app/${APP_NAME}-%d{yyyy-MM-dd}-%i.log.gz">
            <PatternLayout pattern="${LOG_PATTERN}" />
            <Policies>
                <TimeBasedTriggeringPolicy interval="1" modulate="true" />
                <SizeBasedTriggeringPolicy size="100MB" />
            </Policies>
            <DefaultRolloverStrategy max="60" />
        </RollingFile>

        <RollingFile name="ErrorFile"
                     fileName="${LOG_PATH}/error/${APP_NAME}-error.log"
                     filePattern="${LOG_PATH}/error/${APP_NAME}-error-%d{yyyy-MM-dd}-%i.log.gz">
            <PatternLayout pattern="${LOG_PATTERN}" />
            <LevelRangeFilter minLevel="ERROR" maxLevel="ERROR" onMatch="ACCEPT" onMismatch="DENY"/>
            <Policies>
                <TimeBasedTriggeringPolicy interval="1" modulate="true" />
                <SizeBasedTriggeringPolicy size="100MB" />
            </Policies>
            <DefaultRolloverStrategy max="90" />
        </RollingFile>

        <RollingFile name="EventFile"
                     fileName="${LOG_PATH}/event/log/${APP_NAME}-event.log"
                     filePattern="${LOG_PATH}/event/log/${APP_NAME}-event-%d{yyyy-MM-dd}-%i.log.gz">
            <PatternLayout pattern="${LOG_PATTERN}" />
            <Policies>
                <TimeBasedTriggeringPolicy interval="1" modulate="true" />
                <SizeBasedTriggeringPolicy size="100MB" />
            </Policies>
            <DefaultRolloverStrategy max="60" />
        </RollingFile>

        <RollingFile name="EventErrorFile"
                     fileName="${LOG_PATH}/event/error/${APP_NAME}-event-error.log"
                     filePattern="${LOG_PATH}/event/error/${APP_NAME}-event-error-%d{yyyy-MM-dd}-%i.log.gz">
            <PatternLayout pattern="${LOG_PATTERN}" />
            <LevelRangeFilter minLevel="ERROR" maxLevel="ERROR" onMatch="ACCEPT" onMismatch="DENY"/>
            <Policies>
                <TimeBasedTriggeringPolicy interval="1" modulate="true" />
                <SizeBasedTriggeringPolicy size="100MB" />
            </Policies>
            <DefaultRolloverStrategy max="90" />
        </RollingFile>

        <Async name="AsyncApp" bufferSize="500">
            <AppenderRef ref="AppFile" />
            <AppenderRef ref="ErrorFile" />
        </Async>

        <Async name="AsyncEvent" bufferSize="500">
            <AppenderRef ref="EventFile" />
            <AppenderRef ref="EventErrorFile" />
        </Async>

        <RollingFile name="HttpFile"
                     fileName="${LOG_PATH}/http/${APP_NAME}-http.log"
                     filePattern="${LOG_PATH}/http/${APP_NAME}-http-%d{yyyy-MM-dd}-%i.log.gz">
            <PatternLayout pattern="${LOG_PATTERN}" />
            <Policies>
                <TimeBasedTriggeringPolicy interval="1" modulate="true" />
                <SizeBasedTriggeringPolicy size="100MB" />
            </Policies>
            <DefaultRolloverStrategy max="30" />
        </RollingFile>

        <Async name="AsyncHttp" bufferSize="500">
            <AppenderRef ref="HttpFile" />
        </Async>
    </Appenders>

    <Loggers>
        <Logger name="sti.project.scada.http" level="INFO" additivity="false">
            <AppenderRef ref="AsyncHttp" />
        </Logger>

        <Logger name="sti.project.scada.event" level="INFO" additivity="false">
            <AppenderRef ref="Console" />
            <AppenderRef ref="AsyncEvent" />
        </Logger>

        <Logger name="sti.project.scada" level="INFO" additivity="false">
            <AppenderRef ref="Console" />
            <AppenderRef ref="AsyncApp" />
        </Logger>

        <Logger name="org.springframework" level="WARN" additivity="false">
            <AppenderRef ref="Console" />
            <AppenderRef ref="AsyncApp" />
        </Logger>

        <Logger name="org.hibernate" level="WARN" additivity="false">
            <AppenderRef ref="AsyncApp" />
        </Logger>

        <Logger name="org.springframework.security" level="WARN" additivity="false">
            <AppenderRef ref="Console" />
            <AppenderRef ref="AsyncApp" />
        </Logger>

        <Root level="WARN">
            <AppenderRef ref="Console" />
            <AppenderRef ref="AsyncApp" />
        </Root>
    </Loggers>

</Configuration>